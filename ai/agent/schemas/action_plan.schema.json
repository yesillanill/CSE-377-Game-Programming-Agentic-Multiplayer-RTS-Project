{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cse377.local/schemas/action_plan.schema.json",
  "title": "RTSActionPlan",
  "description": "Machine-executable plan proposed by the AI Strategic Commander. Unity shows it to the player, and only after APPROVE does GameActionValidator re-check and execute each action through GameCommands.",
  "type": "object",
  "required": ["summary", "confidence", "actions"],
  "additionalProperties": false,
  "properties": {
    "summary": {"type": "string", "maxLength": 400},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "actions": {
      "type": "array",
      "maxItems": 8,
      "items": {"$ref": "#/$defs/action"}
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "required": ["action_type", "reason"],
      "additionalProperties": false,
      "properties": {
        "action_type": {"enum": ["TRAIN_UNIT", "BUILD", "MOVE_GROUP", "RESEARCH"]},
        "unit_type": {"enum": ["Worker", "Spearman", "Archer", "Cavalry"]},
        "building_type": {"enum": ["House", "Barracks", "Stable", "Blacksmith", "Mine", "DefenseTower"]},
        "tech_line": {"enum": ["weapon", "armor", "wall"]},
        "count": {"type": "integer", "minimum": 1, "maximum": 20},
        "target_zone": {"enum": ["NorthWest", "North", "NorthEast", "West", "Center", "East", "SouthWest", "South", "SouthEast"]},
        "reason": {"type": "string", "maxLength": 250}
      },
      "allOf": [
        {"if": {"properties": {"action_type": {"const": "TRAIN_UNIT"}}},
         "then": {"required": ["unit_type", "count"]}},
        {"if": {"properties": {"action_type": {"const": "BUILD"}}},
         "then": {"required": ["building_type"]}},
        {"if": {"properties": {"action_type": {"const": "RESEARCH"}}},
         "then": {"required": ["tech_line"]}},
        {"if": {"properties": {"action_type": {"const": "MOVE_GROUP"}}},
         "then": {"required": ["target_zone"]}}
      ]
    }
  }
}
